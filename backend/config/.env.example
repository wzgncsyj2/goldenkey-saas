# ============================================================
# 环境配置模板
# ============================================================
# 复制为 .env.dev / .env.test / .env.prod 并填入实际值
# 
# 使用方式:
#   cp .env.example .env.dev
#   # 编辑 .env.dev 填入你的配置

# --- 应用 ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# --- 数据库 ---
# SQLite (开发)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL (生产)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/goldenkey

# --- JWT ---
# 生产环境必须用强随机密钥！
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM ---
# OpenAI
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# DeepSeek (可选)
# LLM_API_KEY=sk-your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- Embedding ---
EMBEDDING_API_KEY=sk-your-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- 向量数据库 ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- 文件存储 ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- 租户配额 ---
FREE_MAX_DOCUMENTS=10
FREE_MAX_STORAGE_MB=100
FREE_MAX_API_CALLS_PER_DAY=100

# --- CORS ---
# 开发环境: ["*"]
# 生产环境: ["https://yourdomain.com","https://app.yourdomain.com"]
CORS_ORIGINS=["*"]
